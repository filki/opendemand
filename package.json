{
  "name": "opendemand",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "OpenDemand desktop frontend: local-first SKU-level demand forecasting workspace",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check",
    "test": "node --experimental-strip-types --test tests/frontend/*.test.ts",
    "build:sidecar": "uv run --frozen python packaging/build_sidecar.py",
    "build:desktop": "npm run build:sidecar && tauri build --config src-tauri/tauri.bundle.conf.json",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tanstack/svelte-query": "^6.3.2",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-dialog": "^2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^22.15.0",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
